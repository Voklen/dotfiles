// == Alex's Config! ==
{
	"layer": "bottom",
	"position": "top",
	"height": 30, // Waybar height (to be removed for auto height)
	"margin-right": 8,
	"margin-left": 8,
	"margin-top": 8,
	// "margin": "10",
	// == Module order ==
	"modules-left": [
		"idle_inhibitor",
		"clock#time",
		"clock#date",
		"custom/updates",
		"hyprland/language",
		"keyboard-state",
		"wireplumber",
		"power-profiles-daemon",
		"tray",
	],
	"modules-center": [
		"hyprland/submap",
		"hyprland/workspaces",
	],
	"modules-right": [
		"backlight",
		"cpu",
		"memory",
		"temperature",
		"network",
		"battery",
	],
	// == Modules configuration ==
	// == Left Modules ==
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "",
			"deactivated": "󰣇"
		}
	},
	"clock#time": {
		"interval": 10,
		"format": "{:%H:%M}",
		"tooltip": false
	},
	"clock#date": {
		"interval": 20,
		"format": "{:%e %b %Y}",
		"tooltip-format": "{:%e %B %Y}"
	},
	"custom/updates": {
		"format": "  {}",
		"escape": true,
		"return-type": "json",
		"exec": "~/.config/scripts/updates.sh",
		"restart-interval": 60,
	},
	"hyprland/language": {
		"format": "󰌌  {}",
		"format-pl": "DV",
		"format-en": "EN",
		"format-ru": "РУ",
		"format-ar": "AR",
		"tooltip": false
	},
	"keyboard-state": {
		"numlock": true,
		"capslock": true,
		"format": {
			"numlock": "󰎠 {icon}",
			"capslock": "󰪛 {icon}",
		},
		"format-icons": {
			"locked": "",
			"unlocked": ""
		}
	},
	"wireplumber": {
		"format": "{icon}  {volume}%",
		"format-bluetooth": "{volume}% {icon}",
		"format-muted": "󰖁",
		"format-icons": {
			"headphone": "󰋋",
			"hands-free": "",
			"headset": "󰋎",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				""
			]
		},
		"scroll-step": 0.5,
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"tooltip": false
	},
	"tray": {
		// "icon-size": 21,
		"spacing": 10,
	},
	// == Centre Modules ==
	"hyprland/workspaces": {
		"sort-by": "id",
		"show-special": true,
		"special-visible-only": true,
		"format": "{icon}",
		"format-icons": {
			"special": "✨",
		},
	},
	// == Right Modules ==
	"power-profiles-daemon": {
		"format": "{icon}",
		"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"default": "",
			"performance": "",
			"balanced": "",
			"power-saver": ""
		}
	},
	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			""
		]
	},
	"cpu": {
		"interval": 5,
		"tooltip": false,
		"format": "  {usage}%",
		"states": {
			"warning": 70,
			"critical": 90
		}
	},
	"memory": {
		"interval": 5,
		"format": "  {percentage}%",
		"states": {
			"warning": 70,
			"critical": 90
		},
		"tooltip": false
	},
	"temperature": {
		// Make a soft link here to your hwmon path.
		// Something like /sys/class/hwmon/hwmon1/temp1_input
		// "hwmon-path": "/home/sasha/.config/cpu_temp",
		"critical-threshold": 85,
		"interval": 5,
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"tooltip": false
	},
	"network": {
		"interval": 5,
		"format-wifi": "  {essid} ({signalStrength}%)",
		"format-ethernet": "󰈀 {ifname}",
		"format-disconnected": "󰀦 No connection",
		"format-linked": " {ifname} (No IP)",
		"format-alt": "󰩠 {ipaddr}/{cidr}",
		"tooltip": false
	},
	"battery": {
		"interval": 10,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format-time": "{H}:{M:02}",
		"format": "{icon} {capacity}%  󰔛 {time}",
		"format-full": "{icon} {capacity}%",
		"format-charging": "󰂅 {capacity}%  󰔛 {time}",
		"format-charging-full": "󱟢 {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{icon} {power}W 󰔛 {time}",
		"format-icons": [
			"󰂎",
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		],
		"tooltip": false
	},
}